## Template: SealedSecret for Alertmanager SMTP
#
# This is a template/example showing the sealed secret filename and structure.
# Do NOT store plain passwords in the repo. Use `scripts/create_sealedsecret.ps1`
# to generate a real SealedSecret and commit that file instead.

apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: alertmanager-smtp-secret
  namespace: monitoring
spec:
  encryptedData:
    smtp_password: <SEALED_VALUE_HERE>

# Replace <SEALED_VALUE_HERE> by running the helper script:
# pwsh .\scripts\create_sealedsecret.ps1
